{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------
  // O OpenCode roda em modelos OpenAI (login ChatGPT Plus/Pro).
  //
  // NAO aponte agente nenhum para "anthropic/*" com login de assinatura:
  // a Anthropic permite OAuth de Pro/Max apenas no Claude Code e nos apps
  // nativos dela, e bloqueia no servidor. Ver code.claude.com/docs/en/
  // legal-and-compliance. O Claude entra nesta esteira pela ferramenta
  // `claude`, que chama o CLI oficial — coberto pela assinatura e permitido.
  //
  // Sem login OpenAI? Troque para um modelo free do Zen (ex.: opencode/glm-5-free)
  // e a esteira segue funcionando: o peso esta nas ferramentas, nao no maestro.
  // `opencode models` lista o que o seu login liberou de fato.
  // ---------------------------------------------------------------
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "arquiteto",

  // Reaproveita o contexto que voce ja escreveu para o Claude Code.
  "instructions": ["AGENTS.md", "CLAUDE.md", ".claude/CLAUDE.md"],

  // Reaproveita as skills que voce ja tem no Claude Code / Codex.
  "skills": {
    "paths": ["~/.claude/skills", "~/.codex/skills"]
  },

  "permission": {
    "webfetch": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "npm publish*": "ask",
      "railway *": "ask"
    },
    "edit": "allow"
  },

  "mcp": {
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true
    },
    "mui": {
      "type": "local",
      "command": ["npx", "-y", "@mui/mcp@latest"],
      "enabled": false
    }
  }
}
