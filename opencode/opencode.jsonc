{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------
  // Modelo padrao da esteira. Troque com /models dentro do opencode.
  // Rode `opencode models` para ver o que seu login liberou de fato.
  // ---------------------------------------------------------------
  "model": "anthropic/claude-opus-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "arquiteto",

  // Reaproveita o contexto que voce ja escreveu para o Claude Code.
  "instructions": ["AGENTS.md", "CLAUDE.md", ".claude/CLAUDE.md"],

  // Reaproveita as skills que voce ja tem no Claude Code / Codex.
  "skills": {
    "paths": ["~/.claude/skills", "~/.codex/skills"]
  },

  "permission": {
    "webfetch": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "npm publish*": "ask",
      "railway *": "ask"
    },
    "edit": "allow"
  },

  "mcp": {
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true
    },
    "mui": {
      "type": "local",
      "command": ["npx", "-y", "@mui/mcp@latest"],
      "enabled": false
    }
  }
}
